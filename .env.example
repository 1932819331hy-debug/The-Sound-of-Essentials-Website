# Lulu Print API Credentials
LULU_CLIENT_KEY=your_client_key_here
LULU_CLIENT_SECRET=your_client_secret_here
LULU_ENV=production
LULU_API_URL=https://api.lulu.com
LULU_TOKEN_URL=https://api.lulu.com/auth/realms/glasstree/protocol/openid-connect/token

# SOE Market Campaign Launch System (SOE-MCLS)
# Set SOE_DRY_RUN=false for live ad spend; keep true for safe simulation
SOE_DRY_RUN=true
BASE_DOMAIN=https://soelearn.com

# Meta Marketing API v21.0 & Conversions API (CAPI)
META_ACCESS_TOKEN=your_system_user_access_token_here
META_PAGE_ACCESS_TOKEN=your_page_access_token_here
META_AD_ACCOUNT_ID=act_your_ad_account_id_here
META_PIXEL_ID=your_dataset_or_pixel_id_here
META_PAGE_ID=your_facebook_page_id_here
META_IG_USER_ID=your_instagram_business_account_id_here

# Brevo CRM (18-Campaign Catalog & Nurture Engine)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=info@soelearn.com
BREVO_SENDER_NAME="The Sound of Essentials"

# Stripe (Card Vaulting & One-Click Upsells)
STRIPE_SECRET_KEY=sk_test_or_live_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Pinterest Marketing & Catalogs API v5
PINTEREST_APP_ID=1627027
PINTEREST_APP_SECRET=your_pinterest_app_secret_here
PINTEREST_AD_ACCOUNT_ID=your_pinterest_ad_account_id_here
PINTEREST_TAG_ID=your_pinterest_tag_id_here

